{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azuredatafactoryforspotifydata"
		},
		"linked_ser_ADLS_sink_for_spotify_db_data_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://spotifystorageaccount02.dfs.core.windows.net/"
		},
		"linked_ser_for_Azure_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://vault-for-spotify-adf.vault.azure.net/"
		},
		"linked_ser_for_spotify_source_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sales-0120-server.database.windows.net"
		},
		"linked_ser_for_spotify_source_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifydatabase"
		},
		"linked_ser_for_spotify_source_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "syam's_saledb"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azuredatafactoryforspotifydata_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linked_ser_ADLS_sink_for_spotify_db_data_properties_typeProperties_url": {
						"value": "[parameters('linked_ser_ADLS_sink_for_spotify_db_data_properties_typeProperties_url')]"
					},
					"linked_ser_for_Azure_key_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('linked_ser_for_Azure_key_vault_properties_typeProperties_baseUrl')]"
					},
					"linked_ser_for_spotify_source_sql_db_properties_typeProperties_server": {
						"value": "[parameters('linked_ser_for_spotify_source_sql_db_properties_typeProperties_server')]"
					},
					"linked_ser_for_spotify_source_sql_db_properties_typeProperties_database": {
						"value": "[parameters('linked_ser_for_spotify_source_sql_db_properties_typeProperties_database')]"
					},
					"linked_ser_for_spotify_source_sql_db_properties_typeProperties_userName": {
						"value": "[parameters('linked_ser_for_spotify_source_sql_db_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}